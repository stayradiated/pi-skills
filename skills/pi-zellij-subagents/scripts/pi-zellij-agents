#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
RUNNER="$SCRIPT_DIR/run-agent.sh"

err() { printf 'error: %s\n' "$*" >&2; }
die() { err "$*"; exit 1; }
has() { command -v "$1" >/dev/null 2>&1; }

usage() {
  cat <<'EOF_USAGE'
Usage: pi-zellij-agents COMMAND [ARGS]

Core commands:
  start NAME [options] -- TASK
  check [NAME [CONTEXT_WINDOW]]
  send NAME MESSAGE...
  wait NAME [TIMEOUT_SECONDS]
  close NAME

Advanced commands:
  doctor
  status [NAME]
  capture NAME [LINES]
  result NAME
  info NAME [--field FIELD]
  context NAME [CONTEXT_WINDOW]
  wait-all [TIMEOUT_SECONDS]
  stop NAME
  stop-all
  clean NAME

Start options:
  --cwd DIR               Run in an existing directory (default: current directory)
  --model REF             Pi model for the child (required)
  --thinking LEVEL        Thinking level: off, minimal, low, medium, high, xhigh, or max (required)
EOF_USAGE
}

ROOT=$(pwd -P)
STATE_DIR=${PI_ZELLIJ_STATE_DIR:-"$ROOT/.pi/zellij-subagents"}
[[ "$STATE_DIR" == /* ]] || STATE_DIR="$ROOT/$STATE_DIR"
AGENTS_DIR="$STATE_DIR/agents"

safe_name() {
  local raw=$1 safe
  safe=$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9_-]+/-/g; s/^[-_]+//; s/[-_]+$//')
  [[ -n "$safe" ]] || die "agent name becomes empty after sanitisation"
  [[ ${#safe} -le 63 ]] || die "agent name is too long after sanitisation (max 63 characters)"
  [[ "$safe" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || die "invalid agent name: $raw"
  printf '%s' "$safe"
}

agent_dir() { printf '%s/%s' "$AGENTS_DIR" "$(safe_name "$1")"; }
assert_agent_dir() {
  local dir=$1
  [[ "$(dirname "$dir")" == "$AGENTS_DIR" && "$(basename "$dir")" != . && "$(basename "$dir")" != .. ]] ||
    die "refusing unsafe agent path: $dir"
}
read_file() { [[ -f "$1" ]] && cat "$1" || true; }
write_atomic() { local path=$1 value=$2; printf '%s\n' "$value" >"$path.tmp"; mv "$path.tmp" "$path"; }

ensure_dirs() {
  mkdir -p "$AGENTS_DIR"
}

require_zellij_session() {
  [[ -n "${ZELLIJ_SESSION_NAME:-}" && -n "${ZELLIJ_PANE_ID:-}" ]] ||
    die "pi-zellij-subagents must run inside an attached Zellij session"
}

tab_alive() {
  local target=$1
  zellij action list-tabs 2>/dev/null | awk -v id="$target" 'NR > 1 && $1 == id { found=1 } END { exit !found }'
}

get_tab() {
  local dir=$1 target
  target=$(read_file "$dir/zellij-tab")
  [[ -n "$target" ]] || die "missing Zellij tab ID for $(basename "$dir")"
  printf '%s' "$target"
}

get_pane() {
  local dir=$1 pane attempts=${2:-25}
  for ((attempts; attempts > 0; attempts--)); do
    pane=$(read_file "$dir/zellij-pane")
    [[ -n "$pane" ]] && { printf '%s' "$pane"; return 0; }
    sleep 0.1
  done
  die "missing Zellij pane ID for $(basename "$dir")"
}

status_value() {
  local dir=$1 status target
  status=$(read_file "$dir/status")
  case "$status" in
    starting|running|blocked|done|failed|stopped) ;;
    *) status=unknown ;;
  esac
  if [[ "$status" == starting || "$status" == running ]]; then
    target=$(read_file "$dir/zellij-tab")
    if [[ -n "$target" ]] && ! tab_alive "$target"; then
      status=exited
    fi
  fi
  printf '%s' "$status"
}

cmd_doctor() {
  local failed=0
  for c in bash zellij pi; do
    if has "$c"; then
      printf 'ok   %-8s %s\n' "$c" "$(command -v "$c")"
    else
      printf 'MISS %-8s not found\n' "$c"
      failed=1
    fi
  done
  if [[ -n "${ZELLIJ_SESSION_NAME:-}" && -n "${ZELLIJ_PANE_ID:-}" ]]; then
    printf 'ok   %-8s %s (pane %s)\n' session "$ZELLIJ_SESSION_NAME" "$ZELLIJ_PANE_ID"
  else
    printf 'MISS %-8s not running inside an attached Zellij session\n' session
    failed=1
  fi
  printf 'info state    %s\n' "$STATE_DIR"
  return "$failed"
}

build_prompt() {
  local name=$1 dir=$2 cwd=$3 task=$4
  local status_file="$dir/status" result_file="$dir/result.md" q_status q_result
  printf -v q_status '%q' "$status_file"
  printf -v q_result '%q' "$result_file"

  cat >"$dir/prompt.md" <<EOF_PROMPT
# Subagent: $name

## Task

$task

## Context

- Working directory: $cwd
- Status: $status_file
- Result: $result_file

Stay within the task and working directory. Do not merge, rebase, or push.

You may delegate a genuinely independent, bounded subtask when doing so is worthwhile. Start nested children with a unique name, an explicit model, and an explicit thinking level; assign non-overlapping write scopes; collect, validate, and close them before reporting your handoff. Use $SCRIPT_DIR/pi-zellij-agents as the helper.

Set status atomically to \`running\` before work. Write a concise result covering outcome, evidence, changes, validation, risks, and handoff; then set status to \`done\`. If blocked or failed, write the reason and set status to \`blocked\` or \`failed\`. Remain available for steering.

Status update:

    printf '%s\\n' STATUS > $q_status.tmp && mv $q_status.tmp $q_status

Write the result to $q_result. Begin now.
EOF_PROMPT
}

shell_join() {
  local out='' q arg
  for arg in "$@"; do
    printf -v q '%q' "$arg"
    out+="$q "
  done
  printf '%s' "$out"
}

cmd_start() {
  [[ $# -ge 1 ]] || die "start requires NAME"
  local original_name=$1 name dir task='' cwd="$ROOT" model='' thinking=''
  local target='' original_tab='' pi_bin
  require_zellij_session
  pi_bin=$(command -v pi) || die "pi not found"
  shift
  name=$(safe_name "$original_name")
  dir=$(agent_dir "$name")
  [[ ! -e "$dir" ]] || die "agent '$name' already exists; clean it or choose another name"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --cwd) [[ $# -ge 2 ]] || die "--cwd requires DIR"; cwd=$2; shift 2 ;;
      --model) [[ $# -ge 2 && -n "$2" ]] || die "--model requires REF"; model=$2; shift 2 ;;
      --thinking) [[ $# -ge 2 && -n "$2" ]] || die "--thinking requires LEVEL"; thinking=$2; shift 2 ;;
      --) shift; task="$*"; break ;;
      *) die "unknown start option: $1" ;;
    esac
  done

  [[ -n "${task//[[:space:]]/}" ]] || die "task is empty"
  [[ -n "$model" ]] || die "--model is required"
  case "$thinking" in off|minimal|low|medium|high|xhigh|max) ;; *) die "--thinking must be off, minimal, low, medium, high, xhigh, or max" ;; esac
  [[ -d "$cwd" ]] || die "working directory not found: $cwd"
  cwd=$(cd "$cwd" && pwd -P)

  start_rollback() {
    local rc=$?
    [[ $# -eq 0 ]] || rc=$1
    trap - ERR
    if [[ -n "$target" ]] && tab_alive "$target"; then
      zellij action close-tab-by-id "$target" 2>/dev/null || true
    fi
    if [[ -n "$dir" ]]; then
      assert_agent_dir "$dir"
      rm -rf "$dir"
    fi
    return "$rc"
  }
  trap start_rollback ERR

  ensure_dirs
  mkdir -p "$dir/session"
  write_atomic "$dir/status" starting

  printf '%s\n' "$cwd" >"$dir/cwd"
  printf '%s\n' "$model" >"$dir/model"
  printf '%s\n' "$thinking" >"$dir/thinking"
  printf '%s\n' "$ZELLIJ_PANE_ID" >"$dir/parent-zellij-pane"
  printf '%s\n' "$SCRIPT_DIR/pi-zellij-agents" >"$dir/manager-cli"
  build_prompt "$name" "$dir" "$cwd" "$task"

  local -a pi_args
  pi_args=("$pi_bin" --name "subagent:$name" --session-dir "$dir/session" --model "$model" --thinking "$thinking" --no-approve --no-extensions --no-skills)
  pi_args+=("@$dir/prompt.md" "Execute the managed assignment in the attached brief.")

  local shell_cmd tab_name="agent-$name"
  shell_cmd=$(shell_join "$RUNNER" "$dir" "${pi_args[@]}")
  original_tab=$(zellij action current-tab-info | awk '$1 == "id:" { print $2; exit }')
  target=$(zellij action new-tab --cwd "$cwd" --name "$tab_name" -- bash -c "$shell_cmd")
  if [[ ! "$target" =~ ^[0-9]+$ ]]; then
    err "Zellij did not return a tab ID: $target"
    start_rollback 1 || true
    return 1
  fi
  printf '%s\n' "$target" >"$dir/zellij-tab"
  if [[ "$original_tab" =~ ^[0-9]+$ ]]; then
    zellij action go-to-tab-by-id "$original_tab" >/dev/null
  fi
  trap - ERR

  printf 'started %-20s tab %s\n' "$name" "$target"
  printf 'cwd     %s\n' "$cwd"
}

require_agent() {
  local dir
  dir=$(agent_dir "$1")
  assert_agent_dir "$dir"
  [[ -d "$dir" ]] || die "unknown agent: $(safe_name "$1")"
  printf '%s' "$dir"
}

cmd_send() {
  [[ $# -ge 2 ]] || die "send requires NAME and MESSAGE"
  local name=$1 dir tab pane message
  shift
  message="$*"
  dir=$(require_agent "$name")
  tab=$(get_tab "$dir")
  tab_alive "$tab" || die "Zellij tab is not alive: $tab"
  pane=$(get_pane "$dir")
  zellij action paste --pane-id "$pane" -- "$message"
  zellij action send-keys --pane-id "$pane" Enter
  printf 'sent to %s\n' "$(safe_name "$name")"
}

print_status_one() {
  local name=$1 dir status cwd target
  dir=$(require_agent "$name")
  status=$(status_value "$dir")
  cwd=$(read_file "$dir/cwd")
  target=$(read_file "$dir/zellij-tab")
  printf '%-22s %-9s %-12s %s\n' "$(safe_name "$name")" "$status" "${target:--}" "$cwd"
}

cmd_status() {
  if [[ $# -gt 0 ]]; then
    printf '%-22s %-9s %-12s %s\n' NAME STATUS TAB CWD
    print_status_one "$1"
    return
  fi
  ensure_dirs
  printf '%-22s %-9s %-12s %s\n' NAME STATUS TAB CWD
  local found=0 dir
  shopt -s nullglob
  for dir in "$AGENTS_DIR"/*; do
    found=1
    print_status_one "$(basename "$dir")"
  done
  shopt -u nullglob
  [[ $found -eq 1 ]] || printf '(no agents)\n'
}

cmd_capture() {
  [[ $# -ge 1 ]] || die "capture requires NAME"
  local dir tab pane lines=${2:-80}
  [[ "$lines" =~ ^[0-9]+$ ]] || die "LINES must be a non-negative integer"
  dir=$(require_agent "$1")
  tab=$(get_tab "$dir")
  tab_alive "$tab" || die "Zellij tab is not alive: $tab"
  pane=$(get_pane "$dir")
  zellij action dump-screen --full --pane-id "$pane" | tail -n "$lines"
}

cmd_result() {
  [[ $# -ge 1 ]] || die "result requires NAME"
  local dir status
  dir=$(require_agent "$1")
  status=$(status_value "$dir")
  printf 'status: %s\n\n' "$status"
  if [[ -s "$dir/result.md" ]]; then
    cat "$dir/result.md"
  else
    printf '(no result yet)\n'
  fi
}

cmd_info() {
  [[ $# -ge 1 ]] || die "info requires NAME"
  local dir field=''
  dir=$(require_agent "$1")
  shift
  if [[ $# -gt 0 ]]; then
    [[ "$1" == --field && $# -ge 2 ]] || die "usage: info NAME [--field FIELD]"
    field=$2
  fi
  if [[ -n "$field" ]]; then
    case "$field" in
      name) basename "$dir" ;;
      status) status_value "$dir"; printf '\n' ;;
      cwd|model|thinking|zellij-tab|zellij-pane|parent-zellij-pane) read_file "$dir/$field"; printf '\n' ;;
      state-dir) printf '%s\n' "$dir" ;;
      *) die "unknown field: $field" ;;
    esac
    return
  fi
  printf 'name:       %s\n' "$(basename "$dir")"
  printf 'status:     %s\n' "$(status_value "$dir")"
  printf 'cwd:        %s\n' "$(read_file "$dir/cwd")"
  printf 'model:      %s\n' "$(read_file "$dir/model")"
  printf 'thinking:   %s\n' "$(read_file "$dir/thinking")"
  printf 'tab:        %s\n' "$(read_file "$dir/zellij-tab")"
  printf 'pane:       %s\n' "$(read_file "$dir/zellij-pane")"
  printf 'parent-pane: %s\n' "$(read_file "$dir/parent-zellij-pane")"
  printf 'state-dir:  %s\n' "$dir"
}

cmd_check() {
  [[ $# -le 2 ]] || die "usage: check [NAME [CONTEXT_WINDOW]]"
  if [[ $# -eq 0 ]]; then
    cmd_status
    return
  fi
  local name=$1 dir status session
  dir=$(require_agent "$name")
  status=$(status_value "$dir")
  printf '%-22s %-9s %-12s %s\n' NAME STATUS TAB CWD
  print_status_one "$name"
  printf '\n'
  session=$(find "$dir/session" -type f -name '*.jsonl' -print -quit 2>/dev/null || true)
  if [[ -n "$session" ]] && grep -q '"usage":{' "$session"; then
    cmd_context "$@"
    printf '\n'
  fi
  if [[ -s "$dir/result.md" ]]; then
    printf '%s\n\n' '--- result ---'
    cat "$dir/result.md"
  elif [[ "$status" == done || "$status" == blocked || "$status" == failed ]]; then
    printf '(terminal status has no result)\n'
  fi
}

cmd_context() {
  [[ $# -ge 1 && $# -le 2 ]] || die "usage: context NAME [CONTEXT_WINDOW]"
  local dir session usage input cache_read total window=${2:-} percent
  dir=$(require_agent "$1")
  session=$(find "$dir/session" -type f -name '*.jsonl' -print 2>/dev/null | head -n 1)
  [[ -n "$session" ]] || die "no child session data yet"
  usage=$(grep '"usage":{' "$session" | tail -n 1 || true)
  [[ -n "$usage" ]] || die "no completed model request yet"
  input=$(printf '%s\n' "$usage" | sed -n 's/.*"input":\([0-9][0-9]*\).*/\1/p')
  cache_read=$(printf '%s\n' "$usage" | sed -n 's/.*"cacheRead":\([0-9][0-9]*\).*/\1/p')
  [[ -n "$input" && -n "$cache_read" ]] || die "could not read token usage from child session"
  total=$((input + cache_read))
  printf 'estimated context: %s tokens (input %s + cache read %s)\n' "$total" "$input" "$cache_read"
  if [[ -n "$window" ]]; then
    [[ "$window" =~ ^[1-9][0-9]*$ ]] || die "CONTEXT_WINDOW must be a positive token count"
    percent=$((total * 100 / window))
    printf 'context window:    %s tokens (%s%% used)\n' "$window" "$percent"
    (( percent < 40 )) || printf 'recommendation: start a fresh child rather than reusing this one.\n'
  else
    printf 'tip: pass the model context-window token count to see the percentage; at 40%%, prefer a fresh child.\n'
  fi
}

wait_one() {
  local name=$1 timeout=$2 started now status
  started=$(date +%s)
  while :; do
    status=$(status_value "$(require_agent "$name")")
    case "$status" in
      done) printf '%s done\n' "$(safe_name "$name")"; return 0 ;;
      blocked) printf '%s blocked\n' "$(safe_name "$name")"; return 2 ;;
      failed|exited|stopped) printf '%s %s\n' "$(safe_name "$name")" "$status"; return 1 ;;
    esac
    now=$(date +%s)
    if (( timeout > 0 && now - started >= timeout )); then
      printf '%s timeout\n' "$(safe_name "$name")"
      return 124
    fi
    sleep 2
  done
}

cmd_wait() {
  [[ $# -ge 1 ]] || die "wait requires NAME"
  local timeout=${2:-0}
  [[ "$timeout" =~ ^[0-9]+$ ]] || die "timeout must be a non-negative integer"
  wait_one "$1" "$timeout"
}

cmd_wait_all() {
  local timeout=${1:-0} started now pending status dir name failed=0 blocked=0
  [[ "$timeout" =~ ^[0-9]+$ ]] || die "timeout must be a non-negative integer"
  started=$(date +%s)
  while :; do
    pending=0
    failed=0
    blocked=0
    shopt -s nullglob
    local dirs=("$AGENTS_DIR"/*)
    shopt -u nullglob
    [[ ${#dirs[@]} -gt 0 ]] || { printf '(no agents)\n'; return 0; }
    for dir in "${dirs[@]}"; do
      name=$(basename "$dir")
      status=$(status_value "$dir")
      case "$status" in
        starting|running|unknown) pending=1 ;;
        blocked) blocked=1 ;;
        failed|exited|stopped) failed=1 ;;
      esac
    done
    if [[ $pending -eq 0 ]]; then
      cmd_status
      [[ $failed -eq 0 ]] || return 1
      [[ $blocked -eq 0 ]] || return 2
      return 0
    fi
    now=$(date +%s)
    if (( timeout > 0 && now - started >= timeout )); then
      cmd_status
      return 124
    fi
    sleep 2
  done
}

cmd_stop() {
  [[ $# -ge 1 ]] || die "stop requires NAME"
  local dir target status
  dir=$(require_agent "$1")
  target=$(read_file "$dir/zellij-tab")
  if [[ -n "$target" ]] && tab_alive "$target"; then
    zellij action close-tab-by-id "$target"
  fi
  status=$(status_value "$dir")
  case "$status" in done|failed|blocked) ;; *) write_atomic "$dir/status" stopped ;; esac
  printf 'stopped %s\n' "$(safe_name "$1")"
}

cmd_stop_all() {
  ensure_dirs
  local dir name
  shopt -s nullglob
  for dir in "$AGENTS_DIR"/*; do
    name=$(basename "$dir")
    cmd_stop "$name"
  done
  shopt -u nullglob
}

cmd_close() {
  [[ $# -eq 1 ]] || die "close requires NAME"
  local dir status
  dir=$(require_agent "$1")
  status=$(status_value "$dir")
  case "$status" in
    done|blocked|failed|exited|stopped) ;;
    *) die "agent is $status; close only accepts terminal agents (use stop first to cancel it)" ;;
  esac
  cmd_stop "$1"
  cmd_clean "$1"
}

cmd_clean() {
  [[ $# -eq 1 ]] || die "clean requires NAME"
  local name=$1 dir target
  dir=$(require_agent "$name")
  assert_agent_dir "$dir"
  target=$(read_file "$dir/zellij-tab")
  if [[ -n "$target" ]] && tab_alive "$target"; then
    die "agent is still running; stop it first"
  fi
  rm -rf "$dir"
  printf 'cleaned %s\n' "$(safe_name "$name")"
}

main() {
  local cmd=${1:-}
  [[ -n "$cmd" ]] || { usage; exit 64; }
  shift || true
  case "$cmd" in
    doctor) cmd_doctor "$@" ;;
    start) cmd_start "$@" ;;
    check) cmd_check "$@" ;;
    send) cmd_send "$@" ;;
    status) cmd_status "$@" ;;
    capture) cmd_capture "$@" ;;
    result) cmd_result "$@" ;;
    info) cmd_info "$@" ;;
    context) cmd_context "$@" ;;
    wait) cmd_wait "$@" ;;
    wait-all) cmd_wait_all "$@" ;;
    stop) cmd_stop "$@" ;;
    stop-all) cmd_stop_all "$@" ;;
    close) cmd_close "$@" ;;
    clean) cmd_clean "$@" ;;
    -h|--help|help) usage ;;
    *) usage >&2; die "unknown command: $cmd" ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
