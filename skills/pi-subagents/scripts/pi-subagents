#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
RUNNER="$SCRIPT_DIR/run-agent.sh"

err() { printf 'error: %s\n' "$*" >&2; }
die() { err "$*"; exit 1; }
has() { command -v "$1" >/dev/null 2>&1; }
read_file() { [[ -f "$1" ]] && cat "$1" || true; }
write_atomic() { local path=$1 value=$2; printf '%s\n' "$value" >"$path.tmp"; mv "$path.tmp" "$path"; }

usage() {
  cat <<'EOF'
Usage: pi-subagents COMMAND [ARGS]

Core commands:
  start NAME [options] -- TASK
  check [NAME [CONTEXT_WINDOW]]
  send NAME MESSAGE...
  wait NAME [TIMEOUT_SECONDS]
  close NAME

Advanced commands:
  doctor
  status [NAME]
  capture NAME [LINES]
  result NAME
  info NAME [--field FIELD]
  context NAME [CONTEXT_WINDOW]
  wait-all [TIMEOUT_SECONDS]
  stop NAME
  stop-all
  clean NAME
  limit [NUMBER]

Start options:
  --cwd DIR               Existing working directory (default: project root)
  --model REF             Pi model for the child (required)
  --thinking LEVEL        off, minimal, low, medium, high, xhigh, or max (required)
  --backend NAME          tmux or zellij (overrides automatic selection)
  --session NAME          Existing multiplexer session to target

Outside tmux or Zellij, --session is required. The helper never creates,
attaches to, or deletes multiplexer sessions.
EOF
}

project_root() { git rev-parse --show-toplevel 2>/dev/null || pwd -P; }
ROOT=$(project_root)
ROOT=$(cd "$ROOT" && pwd -P)
STATE_DIR=${PI_SUBAGENT_STATE_DIR:-"$ROOT/.pi/subagents"}
[[ "$STATE_DIR" == /* ]] || STATE_DIR="$ROOT/$STATE_DIR"

ensure_concurrency_limit() {
  local file="$STATE_DIR/concurrency-limit" requested=${PI_SUBAGENT_CONCURRENCY:-8}
  [[ -s "$file" ]] && return 0
  [[ "$requested" =~ ^[1-9][0-9]*$ ]] || die "PI_SUBAGENT_CONCURRENCY must be a positive integer"
  printf '%s\n' "$requested" >"$file.$$.tmp" && mv "$file.$$.tmp" "$file"
}
concurrency_limit() {
  local value
  value=$(read_file "$STATE_DIR/concurrency-limit")
  [[ "$value" =~ ^[1-9][0-9]*$ ]] || die "invalid or uninitialized concurrency limit in $STATE_DIR/concurrency-limit"
  printf '%s' "$value"
}

safe_component() {
  local raw=$1 safe
  safe=$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9_-]+/-/g; s/^[-_]+//; s/[-_]+$//')
  [[ -n "$safe" ]] || die "name becomes empty after sanitisation"
  [[ ${#safe} -le 80 ]] || die "name is too long after sanitisation (max 80 characters)"
  printf '%s' "$safe"
}

if [[ -n "${PI_SUBAGENT_SELF_DIR:-}" ]]; then
  SELF_DIR=$PI_SUBAGENT_SELF_DIR
  [[ "$SELF_DIR" == /* ]] || die "PI_SUBAGENT_SELF_DIR must be absolute"
  AGENTS_DIR="$SELF_DIR/children"
  MANAGER_ID=$(basename "$SELF_DIR")
  MANAGER_PATH=${PI_SUBAGENT_PATH:-$MANAGER_ID}
else
  manager_raw=${PI_SESSION_ID:-${ZELLIJ_PANE_ID:-${TMUX_PANE:-manager-$PPID}}}
  MANAGER_ID=$(safe_component "$manager_raw")
  AGENTS_DIR="$STATE_DIR/managers/$MANAGER_ID/children"
  MANAGER_PATH=${PI_SUBAGENT_PATH:-manager}
fi

ensure_dirs() { mkdir -p "$AGENTS_DIR"; }
agent_dir() { printf '%s/%s' "$AGENTS_DIR" "$(safe_component "$1")"; }
assert_agent_dir() {
  local dir=$1
  [[ "$(dirname "$dir")" == "$AGENTS_DIR" && "$(basename "$dir")" != . && "$(basename "$dir")" != .. ]] ||
    die "refusing unsafe agent path: $dir"
}
require_agent() {
  local dir
  dir=$(agent_dir "$1")
  assert_agent_dir "$dir"
  [[ -d "$dir" ]] || die "unknown direct child: $(safe_component "$1")"
  printf '%s' "$dir"
}

current_backend() {
  local z=0 t=0 pid comm
  [[ -n "${ZELLIJ_SESSION_NAME:-}" && -n "${ZELLIJ_PANE_ID:-}" ]] && z=1
  [[ -n "${TMUX:-}" && -n "${TMUX_PANE:-}" ]] && t=1
  if (( z && !t )); then printf zellij; return; fi
  if (( t && !z )); then printf tmux; return; fi
  if (( z && t )); then
    pid=$PPID
    while [[ "$pid" =~ ^[0-9]+$ ]] && (( pid > 1 )); do
      comm=$(ps -o comm= -p "$pid" 2>/dev/null || true)
      case "$comm" in *zellij*) printf zellij; return ;; *tmux*) printf tmux; return ;; esac
      pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ' || true)
    done
    printf zellij
  fi
}

session_alive() {
  local backend=$1 session=$2
  case "$backend" in
    tmux) tmux has-session -t "=$session" 2>/dev/null ;;
    zellij) zellij list-sessions --no-formatting 2>/dev/null |
      awk -v wanted="$session" '$1 == wanted && $0 !~ /EXITED/ { found=1 } END { exit !found }' ;;
  esac
}

detect_named_backend() {
  local session=$1 t=0 z=0
  has tmux && session_alive tmux "$session" && t=1
  has zellij && session_alive zellij "$session" && z=1
  if (( t && z )); then die "session '$session' exists in both tmux and Zellij; pass --backend"; fi
  if (( t )); then printf tmux; return; fi
  if (( z )); then printf zellij; return; fi
  die "no active tmux or Zellij session named '$session'"
}

resolve_backend_session() {
  local requested_backend=$1 requested_session=$2 active backend session
  active=$(current_backend)
  backend=${requested_backend:-${PI_SUBAGENT_BACKEND:-}}
  [[ -z "$backend" || "$backend" == tmux || "$backend" == zellij ]] || die "backend must be tmux or zellij"

  if [[ -z "$backend" ]]; then
    if [[ -n "$active" ]]; then backend=$active
    elif [[ -n "$requested_session" ]]; then backend=$(detect_named_backend "$requested_session")
    else die "outside tmux/Zellij: start an existing session and pass --session NAME"
    fi
  fi

  session=$requested_session
  if [[ -z "$session" && "$backend" == "$active" ]]; then
    case "$backend" in
      tmux) session=$(tmux display-message -p '#S') ;;
      zellij) session=$ZELLIJ_SESSION_NAME ;;
    esac
  fi
  [[ -n "$session" ]] || die "--session is required because the selected backend is not the current multiplexer"
  has "$backend" || die "$backend is not installed"
  session_alive "$backend" "$session" || die "$backend session is not active: $session"
  printf '%s\n%s\n' "$backend" "$session"
}

parent_endpoint() {
  local active
  active=$(current_backend)
  case "$active" in
    tmux) printf 'tmux\n%s\n%s\n' "$(tmux display-message -p '#S')" "$TMUX_PANE" ;;
    zellij) printf 'zellij\n%s\n%s\n' "$ZELLIJ_SESSION_NAME" "$ZELLIJ_PANE_ID" ;;
    *) printf '\n\n\n' ;;
  esac
}

target_alive() {
  local dir=$1 backend session target
  backend=$(read_file "$dir/backend"); session=$(read_file "$dir/multiplexer-session"); target=$(read_file "$dir/target")
  case "$backend" in
    tmux)
      local actual
      [[ -n "$target" ]] || return 1
      actual=$(tmux display-message -p -t "$target" '#{pane_id}' 2>/dev/null) || return 1
      [[ "$actual" == "$target" ]]
      ;;
    zellij) [[ -n "$target" ]] && zellij --session "$session" action list-tabs 2>/dev/null |
      awk -v id="$target" 'NR > 1 && $1 == id { found=1 } END { exit !found }' ;;
    *) return 1 ;;
  esac
}

steering_pending() {
  local dir=$1 pending completed
  pending=$(read_file "$dir/steering-pending")
  [[ -n "$pending" ]] || return 1
  completed=$(read_file "$dir/steering-completed")
  [[ "$pending" != "$completed" ]]
}

status_value() {
  local dir=$1 status
  status=$(read_file "$dir/status")
  case "$status" in queued|starting|running|blocked|done|failed|stopped) ;; *) status=unknown ;; esac
  if [[ "$status" != queued && "$status" != stopped ]] && steering_pending "$dir"; then
    target_alive "$dir" && status=steering || status=exited
  elif [[ "$status" == starting || "$status" == running ]]; then
    [[ -z "$(read_file "$dir/target")" ]] || target_alive "$dir" || status=exited
  fi
  printf '%s' "$status"
}

readiness_value() {
  local dir=$1
  if target_alive "$dir"; then
    [[ -n "$(read_file "$dir/pane")" ]] && printf ready || printf target
  else
    printf no
  fi
}

build_prompt() {
  local name=$1 dir=$2 cwd=$3 task=$4 path=$5 status_file result_file q_status q_result
  status_file="$dir/status"; result_file="$dir/result.md"
  printf -v q_status '%q' "$status_file"; printf -v q_result '%q' "$result_file"
  cat >"$dir/prompt.md" <<EOF
# Subagent: $name

## Task

$task

Close your direct children before any terminal status.

When finished, write a concise result (outcome, evidence, changed files, validation, risks, handoff). Immediately before a terminal status, atomically write it:

    printf '%s\\n' STATUS > $q_status.tmp && mv $q_status.tmp $q_status

Use \`done\`, \`blocked\`, or \`failed\`; record why when blocked or failed. Write the result to $q_result. Begin now.
EOF
}

shell_join() {
  local out='' q arg
  for arg in "$@"; do printf -v q '%q' "$arg"; out+="$q "; done
  printf '%s' "$out"
}

launch_target() {
  local backend=$1 session=$2 name=$3 cwd=$4 shell_cmd=$5 dir=$6 output target container original
  case "$backend" in
    tmux)
      output=$(tmux new-window -d -P -F '#{pane_id}|#{window_id}' -t "=$session:" -n "agent-$name" -c "$cwd" "bash -c $(printf '%q' "$shell_cmd")")
      IFS='|' read -r target container <<<"$output"
      ;;
    zellij)
      original=''
      [[ "${ZELLIJ_SESSION_NAME:-}" != "$session" ]] || original=$(zellij action current-tab-info | awk '$1 == "id:" { print $2; exit }')
      target=$(zellij --session "$session" action new-tab --cwd "$cwd" --name "agent-$name" -- bash -c "$shell_cmd")
      [[ "$target" =~ ^[0-9]+$ ]] || die "Zellij did not return a tab ID: $target"
      container=$target
      printf '%s\n' "$target" >"$dir/target"
      printf '%s\n' "$container" >"$dir/container"
      [[ ! "$original" =~ ^[0-9]+$ ]] || zellij action go-to-tab-by-id "$original" >/dev/null
      ;;
  esac
  printf '%s\n' "$target" >"$dir/target"
  printf '%s\n' "$container" >"$dir/container"
}

launch_agent_record() {
  local dir=$1 name cwd model thinking backend session path pi_bin shell_cmd target
  name=$(basename "$dir"); cwd=$(read_file "$dir/cwd"); model=$(read_file "$dir/model")
  thinking=$(read_file "$dir/thinking"); backend=$(read_file "$dir/backend")
  session=$(read_file "$dir/multiplexer-session"); path=$(read_file "$dir/hierarchy")
  [[ "$(read_file "$dir/status")" == queued ]] || die "queued child '$name' was cancelled before launch"
  [[ -d "$cwd" ]] || die "queued child '$name' working directory no longer exists: $cwd"
  session_alive "$backend" "$session" || die "queued child '$name' multiplexer session is not active: $session"
  pi_bin=$(command -v pi) || die "pi not found"
  write_atomic "$dir/status" starting
  shell_cmd=$(shell_join "$RUNNER" "$dir" env "PI_SUBAGENT_STATE_DIR=$STATE_DIR" "PI_SUBAGENT_SELF_DIR=$dir" "PI_SUBAGENT_PATH=$path" "$pi_bin" --name "subagent:$name" --session-dir "$dir/session" --model "$model" --thinking "$thinking" "@$dir/prompt.md" "Proceed.")
  launch_target "$backend" "$session" "$name" "$cwd" "$shell_cmd" "$dir"
  target=$(read_file "$dir/target")
  printf 'started %-20s %s:%s target %s\n' "$name" "$backend" "$session" "$target"
}

cmd_start() {
  [[ $# -ge 1 ]] || die "start requires NAME"
  local original_name=$1 name dir cwd="$ROOT" model='' thinking='' backend_arg='' session_arg='' task=''
  local backend session path parent_backend parent_session parent_target pi_bin resolution
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --cwd) [[ $# -ge 2 ]] || die "--cwd requires DIR"; cwd=$2; shift 2 ;;
      --model) [[ $# -ge 2 && -n "$2" ]] || die "--model requires REF"; model=$2; shift 2 ;;
      --thinking) [[ $# -ge 2 && -n "$2" ]] || die "--thinking requires LEVEL"; thinking=$2; shift 2 ;;
      --backend) [[ $# -ge 2 ]] || die "--backend requires NAME"; backend_arg=$2; shift 2 ;;
      --session) [[ $# -ge 2 && -n "$2" ]] || die "--session requires NAME"; session_arg=$2; shift 2 ;;
      --) shift; task="$*"; break ;;
      *) die "unknown start option: $1" ;;
    esac
  done
  [[ -n "${task//[[:space:]]/}" ]] || die "task is empty"
  [[ -n "$model" ]] || die "--model is required"
  case "$thinking" in off|minimal|low|medium|high|xhigh|max) ;; *) die "--thinking must be off, minimal, low, medium, high, xhigh, or max" ;; esac
  [[ -d "$cwd" ]] || die "working directory not found: $cwd"
  cwd=$(cd "$cwd" && pwd -P); pi_bin=$(command -v pi) || die "pi not found"
  resolution=$(resolve_backend_session "$backend_arg" "$session_arg") || return
  mapfile -t resolved <<<"$resolution"; [[ ${#resolved[@]} -eq 2 ]] || die "backend resolution returned malformed output"
  backend=${resolved[0]}; session=${resolved[1]}; mapfile -t parent < <(parent_endpoint)
  parent_backend=${parent[0]:-}; parent_session=${parent[1]:-}; parent_target=${parent[2]:-}

  name=$(safe_component "$original_name"); ensure_dirs
  dispatch_lock_acquire; ensure_concurrency_limit; dispatch_lock_release
  dir=$(agent_dir "$name"); assert_agent_dir "$dir"; mkdir "$dir" 2>/dev/null || die "direct child '$name' already exists; close it or choose another name"
  enqueue_rollback() { local rc=$?; trap - ERR; rm -rf "$dir"; return "$rc"; }
  trap enqueue_rollback ERR
  mkdir -p "$dir/session"; path="$MANAGER_PATH > $name"
  printf '%s\n' "$cwd" >"$dir/cwd"; printf '%s\n' "$model" >"$dir/model"; printf '%s\n' "$thinking" >"$dir/thinking"
  printf '%s\n' "$backend" >"$dir/backend"; printf '%s\n' "$session" >"$dir/multiplexer-session"
  printf '%s\n' "$MANAGER_ID" >"$dir/parent"; printf '%s\n' "$path" >"$dir/hierarchy"
  printf '%s\n' "$parent_backend" >"$dir/parent-backend"; printf '%s\n' "$parent_session" >"$dir/parent-session"; printf '%s\n' "$parent_target" >"$dir/parent-target"
  printf '%s\n' "$SCRIPT_DIR/pi-subagents" >"$dir/manager-cli"; printf '%s\n' "$(date +%s%N)-$$-$RANDOM" >"$dir/queue-ticket"
  build_prompt "$name" "$dir" "$cwd" "$task" "$path"; write_atomic "$dir/status" queued
  trap - ERR
  kick_dispatch
  printf 'queued %-21s ticket %s\n' "$name" "$(read_file "$dir/queue-ticket")"
}

record_dirs() {
  [[ -d "$STATE_DIR/managers" ]] || return 0
  find "$STATE_DIR/managers" -type f -name status -printf '%h\n' 2>/dev/null
}
record_is_active() {
  local dir=$1 status
  status=$(read_file "$dir/status")
  case "$status" in starting|running) return 0 ;; *) return 1 ;; esac
}
record_has_active_descendant() {
  local dir=$1 child
  while IFS= read -r child; do record_is_active "$(dirname "$child")" && return 0; done < <(find "$dir/children" -type f -name status -print 2>/dev/null)
  return 1
}
parent_record_dir() {
  local dir=$1 parent
  [[ "$(basename "$(dirname "$dir")")" == children ]] || return 1
  parent=$(dirname "$(dirname "$dir")")
  [[ -f "$parent/status" ]] && printf '%s' "$parent"
}
active_leaf_count() {
  local dir count=0
  while IFS= read -r dir; do
    if record_is_active "$dir" && ! record_has_active_descendant "$dir"; then count=$((count + 1)); fi
  done < <(record_dirs)
  printf '%s' "$count"
}
queued_records() {
  local dir ticket
  while IFS= read -r dir; do
    [[ "$(read_file "$dir/status")" == queued ]] || continue
    ticket=$(read_file "$dir/queue-ticket"); [[ -n "$ticket" ]] || ticket="0-$(basename "$dir")"
    printf '%s\t%s\n' "$ticket" "$dir"
  done < <(record_dirs) | sort -n -k1,1
}
mark_launch_failed() {
  local dir=$1 message=$2
  target_alive "$dir" && close_target "$dir" >/dev/null 2>&1 || true
  cat >"$dir/result.md" <<EOF
# Result

Queued launch failed: $message
EOF
  write_atomic "$dir/status" failed
}
dispatch_lock_acquire() {
  mkdir -p "$STATE_DIR"
  has flock || die "flock is required for concurrency dispatch"
  exec {DISPATCH_LOCK_FD}>"$STATE_DIR/dispatch.lock"
  flock "$DISPATCH_LOCK_FD"
}
dispatch_lock_release() {
  flock -u "$DISPATCH_LOCK_FD"
  exec {DISPATCH_LOCK_FD}>&-
  unset DISPATCH_LOCK_FD
}
reconcile_dead_records() {
  local dir status
  while IFS= read -r dir; do
    status=$(read_file "$dir/status")
    case "$status" in
      starting|running)
        target_alive "$dir" || mark_launch_failed "$dir" "child target is no longer alive"
        ;;
    esac
  done < <(record_dirs)
}
cmd_dispatch() (
  local limit dir parent cost leaves output before after
  dispatch_lock_acquire
  trap dispatch_lock_release EXIT
  while :; do
    before=$(read_file "$STATE_DIR/dispatch-wake")
    ensure_concurrency_limit; reconcile_dead_records; limit=$(concurrency_limit)
    while IFS=$'\t' read -r _ dir; do
      [[ -d "$dir" && "$(read_file "$dir/status")" == queued ]] || continue
      parent=$(parent_record_dir "$dir" || true)
      if [[ -n "$parent" ]] && ! record_is_active "$parent"; then mark_launch_failed "$dir" "parent is no longer active"; continue; fi
      cost=1
      if [[ -n "$parent" ]] && record_is_active "$parent" && ! record_has_active_descendant "$parent"; then cost=0; fi
      leaves=$(active_leaf_count); (( leaves + cost <= limit )) || continue
      if output=$(launch_agent_record "$dir" 2>&1); then printf '%s\n' "$output" >&2; else mark_launch_failed "$dir" "$output"; fi
    done < <(queued_records)
    after=$(read_file "$STATE_DIR/dispatch-wake")
    if [[ "$before" == "$after" ]]; then break; fi
  done
)
kick_dispatch() {
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$(date +%s%N)-$$-$RANDOM" >"$STATE_DIR/dispatch-wake.$$.tmp"
  mv "$STATE_DIR/dispatch-wake.$$.tmp" "$STATE_DIR/dispatch-wake"
  "$SCRIPT_DIR/pi-subagents" _dispatch >/dev/null 2>&1 &
}

get_child_pane() {
  local dir=$1 pane attempts=${2:-30}
  for ((; attempts > 0; attempts--)); do pane=$(read_file "$dir/pane"); [[ -n "$pane" ]] && { printf '%s' "$pane"; return; }; sleep 0.1; done
  die "missing pane ID for $(basename "$dir")"
}

steering_recorded() {
  local dir=$1 generation=$2 file
  shopt -s nullglob
  local files=("$dir/session"/*.jsonl)
  shopt -u nullglob
  for file in "${files[@]}"; do grep -Fq "$generation" "$file" && return 0; done
  return 1
}

refresh_steering_ack() {
  local dir=$1 pending
  pending=$(read_file "$dir/steering-pending")
  [[ -n "$pending" ]] || return 0
  [[ "$pending" == "$(read_file "$dir/steering-ack")" ]] && return 0
  steering_recorded "$dir" "$pending" && write_atomic "$dir/steering-ack" "$pending"
  return 0
}

steering_queued_visible() {
  local backend=$1 session=$2 pane=$3 generation=$4 marker
  marker="Follow-up: [pi-subagents steering $generation]"
  case "$backend" in
    tmux) tmux capture-pane -p -J -S -80 -t "$pane" 2>/dev/null | grep -Fq "$marker" ;;
    zellij) zellij --session "$session" action dump-screen --full --pane-id "$pane" 2>/dev/null | grep -Fq "$marker" ;;
  esac
}

submit_steering_key() {
  local backend=$1 session=$2 pane=$3
  case "$backend" in
    tmux) tmux send-keys -t "$pane" M-Enter ;;
    zellij) zellij --session "$session" action send-keys --pane-id "$pane" "Alt Enter" ;;
  esac
}

cmd_send() (
  [[ $# -ge 2 ]] || die "send requires NAME and MESSAGE"
  local dir backend session pane user_message wrapped buffer status generation sent=0 injected=0 attempts polls lock
  local previous_pending q_completed
  dir=$(require_agent "$1"); shift; user_message="$*"
  target_alive "$dir" || die "child target is not alive"
  backend=$(read_file "$dir/backend"); session=$(read_file "$dir/multiplexer-session"); pane=$(get_child_pane "$dir")
  lock="$dir/send-lock"
  mkdir "$lock" 2>/dev/null || die "another send is already in progress for $(basename "$dir")"
  trap 'rmdir "$lock" 2>/dev/null || true' EXIT

  dispatch_lock_acquire
  steering_pending "$dir" && die "child already has uncompleted steering; inspect it before sending again"
  status=$(status_value "$dir")
  case "$status" in done|blocked|failed|exited|stopped) die "child is $status; collect its handoff and use a fresh child" ;; esac

  generation="$(date +%s)-$$-$RANDOM"
  previous_pending=$(read_file "$dir/steering-pending")
  write_atomic "$dir/steering-pending" "$generation"
  dispatch_lock_release
  printf -v q_completed '%q' "$dir/steering-completed"
  wrapped=$(cat <<EOF
[pi-subagents steering $generation]

$user_message

Before any terminal status, atomically write:

    printf '%s\\n' $generation > $q_completed.tmp && mv $q_completed.tmp $q_completed

Then update the handoff and set the terminal status. If blocked or failed, record why, complete the generation, and set that status.
EOF
)
  case "$backend" in
    tmux)
      buffer="pi-subagent-$RANDOM-$$"
      if printf '%s' "$wrapped" | tmux load-buffer -b "$buffer" - && tmux paste-buffer -b "$buffer" -d -t "$pane"; then injected=1; fi
      ;;
    zellij)
      zellij --session "$session" action paste --pane-id "$pane" -- "$wrapped" && injected=1
      ;;
  esac
  if (( !injected )); then
    if [[ -n "$previous_pending" ]]; then write_atomic "$dir/steering-pending" "$previous_pending"; else rm -f "$dir/steering-pending"; fi
    die "failed to inject steering into $(basename "$dir")"
  fi

  # Pi uses Alt+Enter for follow-ups. Startup and paste processing are
  # asynchronous, so retry only the submit key until Pi shows the queued message
  # or records it in the session; never paste the request twice.
  sleep 0.2
  for ((attempts = 0; attempts < 10 && !sent; attempts++)); do
    submit_steering_key "$backend" "$session" "$pane" || true
    for ((polls = 0; polls < 4; polls++)); do
      sleep 0.25
      if steering_recorded "$dir" "$generation" || steering_queued_visible "$backend" "$session" "$pane" "$generation"; then sent=1; break; fi
    done
  done
  if (( !sent )); then
    err "steering was pasted into $(basename "$dir"), but submission was not confirmed; inspect with capture"
    return 1
  fi
  refresh_steering_ack "$dir"
  printf 'queued steering %s for %s; completion pending\n' "$generation" "$(basename "$dir")"
)

print_status_one() {
  local dir=$1
  printf '%-22s %-9s %-6s %-8s %-20s %s\n' "$(basename "$dir")" "$(status_value "$dir")" "$(readiness_value "$dir")" "$(read_file "$dir/backend")" "$(read_file "$dir/multiplexer-session")" "$(read_file "$dir/cwd")"
}
cmd_status() {
  printf '%-22s %-9s %-6s %-8s %-20s %s\n' NAME STATUS READY BACKEND SESSION CWD
  if [[ $# -gt 0 ]]; then print_status_one "$(require_agent "$1")"; return; fi
  ensure_dirs; local found=0 dir; shopt -s nullglob
  for dir in "$AGENTS_DIR"/*; do found=1; print_status_one "$dir"; done
  shopt -u nullglob; (( found )) || printf '(no direct children)\n'
}

cmd_capture() {
  [[ $# -ge 1 ]] || die "capture requires NAME"
  local dir backend session pane lines=${2:-80}; [[ "$lines" =~ ^[0-9]+$ ]] || die "LINES must be non-negative"
  dir=$(require_agent "$1"); target_alive "$dir" || die "child target is not alive"
  backend=$(read_file "$dir/backend"); session=$(read_file "$dir/multiplexer-session"); pane=$(get_child_pane "$dir")
  case "$backend" in tmux) tmux capture-pane -p -J -S "-$lines" -t "$pane" ;; zellij) zellij --session "$session" action dump-screen --full --pane-id "$pane" | tail -n "$lines" ;; esac
}
cmd_result() {
  local dir; [[ $# -ge 1 ]] || die "result requires NAME"; dir=$(require_agent "$1")
  printf 'status: %s\n\n' "$(status_value "$dir")"; [[ -s "$dir/result.md" ]] && cat "$dir/result.md" || printf '(no result yet)\n'
}
latest_session_file() {
  local dir=$1 file latest=''
  shopt -s nullglob
  local files=("$dir/session"/*.jsonl)
  shopt -u nullglob
  for file in "${files[@]}"; do [[ -z "$latest" || "$file" -nt "$latest" ]] && latest=$file; done
  [[ -n "$latest" ]] && printf '%s' "$latest"
}

cmd_context() {
  [[ $# -ge 1 && $# -le 2 ]] || die "usage: context NAME [CONTEXT_WINDOW]"
  local dir session line input='' cache='' candidate_input candidate_cache total window=${2:-} percent
  local usage_re='"usage":\{"input":([0-9]+),"output":[0-9]+,"cacheRead":([0-9]+)'
  dir=$(require_agent "$1"); session=$(latest_session_file "$dir" || true)
  [[ -n "$session" ]] || die "no child session data yet"
  while IFS= read -r line; do
    if [[ "$line" =~ $usage_re ]]; then
      candidate_input=${BASH_REMATCH[1]}; candidate_cache=${BASH_REMATCH[2]}
      if (( candidate_input + candidate_cache > 0 )); then input=$candidate_input; cache=$candidate_cache; fi
    fi
  done <"$session"
  [[ -n "$input" && -n "$cache" ]] || die "no meaningful completed model request yet"
  total=$((input + cache)); printf 'estimated context: %s tokens (input %s + cache read %s)\n' "$total" "$input" "$cache"
  if [[ -n "$window" ]]; then [[ "$window" =~ ^[1-9][0-9]*$ ]] || die "CONTEXT_WINDOW must be positive"; percent=$((total * 100 / window)); printf 'context window:    %s tokens (%s%% used)\n' "$window" "$percent"; (( percent < 40 )) || printf 'recommendation: start a fresh child rather than reusing this one.\n'; fi
}
cmd_check() {
  [[ $# -le 2 ]] || die "usage: check [NAME [CONTEXT_WINDOW]]"
  kick_dispatch
  if [[ $# -eq 0 ]]; then cmd_status; return; fi
  local dir session; dir=$(require_agent "$1"); refresh_steering_ack "$dir"; cmd_status "$1"; printf '\n'
  session=$(latest_session_file "$dir" || true)
  if [[ -n "$session" ]] && grep -q '"usage":{' "$session"; then cmd_context "$@"; printf '\n'; fi
  if steering_pending "$dir"; then
    printf 'steering pending:   %s\n' "$(read_file "$dir/steering-pending")"
    printf 'steering ack:       %s\n\n' "$(read_file "$dir/steering-ack")"
  fi
  if [[ -s "$dir/result.md" ]]; then printf '%s\n\n' '--- result ---'; cat "$dir/result.md"; fi
}
cmd_info() {
  [[ $# -ge 1 ]] || die "info requires NAME"; local dir field=''; dir=$(require_agent "$1"); shift
  if [[ $# -gt 0 ]]; then [[ "$1" == --field && $# -eq 2 ]] || die "usage: info NAME [--field FIELD]"; field=$2; fi
  if [[ -n "$field" ]]; then case "$field" in status) status_value "$dir"; printf '\n' ;; state-dir) printf '%s\n' "$dir" ;; name) basename "$dir" ;; cwd|model|thinking|backend|multiplexer-session|target|pane|parent|hierarchy) read_file "$dir/$field"; printf '\n' ;; *) die "unknown field: $field" ;; esac; return; fi
  for field in name status cwd model thinking backend multiplexer-session target pane parent hierarchy state-dir; do printf '%-20s ' "$field:"; cmd_info "$(basename "$dir")" --field "$field"; done
}

wait_one() {
  local name=$1 timeout=$2 started now status dir; started=$(date +%s)
  while :; do kick_dispatch; dir=$(require_agent "$name"); refresh_steering_ack "$dir"; status=$(status_value "$dir"); case "$status" in done) printf '%s done\n' "$name"; return 0 ;; blocked) printf '%s blocked\n' "$name"; return 2 ;; failed|exited|stopped) printf '%s %s\n' "$name" "$status"; return 1 ;; esac; now=$(date +%s); if (( timeout > 0 && now - started >= timeout )); then printf '%s timeout\n' "$name"; return 124; fi; sleep 2; done
}
cmd_wait() { [[ $# -ge 1 ]] || die "wait requires NAME"; local timeout=${2:-0}; [[ "$timeout" =~ ^[0-9]+$ ]] || die "timeout must be non-negative"; wait_one "$1" "$timeout"; }
cmd_wait_all() {
  local timeout=${1:-0} started now pending failed blocked dir status; [[ "$timeout" =~ ^[0-9]+$ ]] || die "timeout must be non-negative"; started=$(date +%s)
  while :; do kick_dispatch; pending=0; failed=0; blocked=0; shopt -s nullglob; local dirs=("$AGENTS_DIR"/*); shopt -u nullglob; ((${#dirs[@]})) || { printf '(no direct children)\n'; return 0; }; for dir in "${dirs[@]}"; do status=$(status_value "$dir"); case "$status" in queued|starting|running|steering|unknown) pending=1 ;; blocked) blocked=1 ;; failed|exited|stopped) failed=1 ;; esac; done; if (( !pending )); then cmd_status; (( !failed )) || return 1; (( !blocked )) || return 2; return 0; fi; now=$(date +%s); if (( timeout > 0 && now - started >= timeout )); then cmd_status; return 124; fi; sleep 2; done
}

close_target() {
  local dir=$1 backend session target container
  backend=$(read_file "$dir/backend"); session=$(read_file "$dir/multiplexer-session"); target=$(read_file "$dir/target"); container=$(read_file "$dir/container")
  case "$backend" in tmux) tmux kill-window -t "$container" ;; zellij) zellij --session "$session" action close-tab-by-id "$target" ;; esac
}
cmd_stop() (
  [[ $# -eq 1 ]] || die "stop requires NAME"; local dir status; dispatch_lock_acquire; trap dispatch_lock_release EXIT
  dir=$(require_agent "$1"); target_alive "$dir" && close_target "$dir" || true
  status=$(status_value "$dir"); case "$status" in done|failed|blocked) ;; *) write_atomic "$dir/status" stopped ;; esac
  kick_dispatch; printf 'stopped %s\n' "$(basename "$dir")"
)
cmd_stop_all() { ensure_dirs; local dir; shopt -s nullglob; for dir in "$AGENTS_DIR"/*; do cmd_stop "$(basename "$dir")"; done; shopt -u nullglob; }
has_children() { local dir=$1 child; shopt -s nullglob; local children=("$dir/children"/*); shopt -u nullglob; ((${#children[@]} > 0)); }
list_children() { local dir=$1 child; shopt -s nullglob; for child in "$dir/children"/*; do [[ -d "$child" ]] && printf '  %s (%s)\n' "$(basename "$child")" "$(status_value "$child")" >&2; done; shopt -u nullglob; }
cmd_clean() (
  [[ $# -eq 1 ]] || die "clean requires NAME"; local dir; dispatch_lock_acquire; trap dispatch_lock_release EXIT
  dir=$(require_agent "$1"); assert_agent_dir "$dir"
  if has_children "$dir"; then err "child '$(basename "$dir")' still owns direct children:"; list_children "$dir"; die "ask that child to close its children first"; fi
  target_alive "$dir" && die "child target is still alive; stop it first"
  rm -rf "$dir"; printf 'cleaned %s\n' "$(basename "$dir")"
)
cmd_close() (
  [[ $# -eq 1 ]] || die "close requires NAME"; local dir status; dispatch_lock_acquire; trap dispatch_lock_release EXIT
  dir=$(require_agent "$1"); [[ ! -d "$dir/send-lock" ]] || die "child has a send in progress"
  if has_children "$dir"; then err "child '$(basename "$dir")' still owns direct children:"; list_children "$dir"; die "ask that child to close its children first"; fi
  status=$(status_value "$dir"); case "$status" in done|blocked|failed|exited|stopped) ;; *) die "child is $status; close accepts terminal children only (use stop to cancel)" ;; esac
  target_alive "$dir" && close_target "$dir" || true
  printf 'closed %s\n' "$(basename "$dir")"; rm -rf "$dir"; printf 'cleaned %s\n' "$1"
)
cmd_limit() (
  [[ $# -le 1 ]] || die "usage: limit [NUMBER]"
  dispatch_lock_acquire; trap dispatch_lock_release EXIT
  ensure_concurrency_limit
  if [[ $# -eq 1 ]]; then
    [[ "$1" =~ ^[1-9][0-9]*$ ]] || die "limit must be a positive integer"
    printf '%s\n' "$1" >"$STATE_DIR/concurrency-limit.$$.tmp" && mv "$STATE_DIR/concurrency-limit.$$.tmp" "$STATE_DIR/concurrency-limit"
    kick_dispatch
  fi
  printf '%s\n' "$(concurrency_limit)"
)
cmd_doctor() {
  local failed=0 active limit; dispatch_lock_acquire; ensure_concurrency_limit; limit=$(concurrency_limit); dispatch_lock_release
  for c in bash pi flock; do if has "$c"; then printf 'ok   %-8s %s\n' "$c" "$(command -v "$c")"; else printf 'MISS %-8s not found\n' "$c"; failed=1; fi; done
  for c in zellij tmux; do has "$c" && printf 'ok   %-8s %s\n' "$c" "$(command -v "$c")" || printf 'info %-8s not installed\n' "$c"; done
  has zellij || has tmux || failed=1; active=$(current_backend); printf 'info current  %s\n' "${active:-none}"; printf 'info state    %s\n' "$STATE_DIR"; printf 'info limit    %s active leaves\n' "$limit"; printf 'info manager  %s\n' "$MANAGER_ID"; return "$failed"
}

main() {
  local cmd=${1:-}; [[ -n "$cmd" ]] || { usage; exit 64; }; shift || true
  case "$cmd" in doctor) cmd_doctor "$@" ;; start) cmd_start "$@" ;; check) cmd_check "$@" ;; send) cmd_send "$@" ;; status) cmd_status "$@" ;; capture) cmd_capture "$@" ;; result) cmd_result "$@" ;; info) cmd_info "$@" ;; context) cmd_context "$@" ;; wait) cmd_wait "$@" ;; wait-all) cmd_wait_all "$@" ;; stop) cmd_stop "$@" ;; stop-all) cmd_stop_all "$@" ;; close) cmd_close "$@" ;; clean) cmd_clean "$@" ;; limit) cmd_limit "$@" ;; _dispatch) cmd_dispatch "$@" ;; -h|--help|help) usage ;; *) usage >&2; die "unknown command: $cmd" ;; esac
}
[[ "${BASH_SOURCE[0]}" != "$0" ]] || main "$@"
