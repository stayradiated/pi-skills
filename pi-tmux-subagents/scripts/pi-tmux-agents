#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
RUNNER="$SCRIPT_DIR/run-agent.sh"

err() { printf 'error: %s\n' "$*" >&2; }
die() { err "$*"; exit 1; }
has() { command -v "$1" >/dev/null 2>&1; }

usage() {
  cat <<'EOF_USAGE'
Usage: pi-tmux-agents COMMAND [ARGS]

Commands:
  doctor
  init
  start NAME [options] -- TASK
  send NAME MESSAGE...
  status [NAME]
  capture NAME [LINES]
  result NAME
  info NAME [--field FIELD]
  wait NAME [TIMEOUT_SECONDS]
  wait-all [TIMEOUT_SECONDS]
  stop NAME
  stop-all
  clean NAME [--remove-worktree]
  clean-all

Start options:
  --worktree              Create an isolated Git worktree and branch
  --cwd DIR               Run in an existing directory
  --model MODEL           Pi model pattern or ID
  --provider PROVIDER     Pi provider
  --thinking LEVEL        Pi thinking level
  --tools LIST            Pi tool allowlist
  --no-context            Disable AGENTS.md / CLAUDE.md discovery
  --approve-project       Trust project-local Pi resources for this child
  --inherit-resources     Load discovered extensions and skills
  --task-file FILE        Read task from FILE
EOF_USAGE
}

project_root() {
  git rev-parse --show-toplevel 2>/dev/null || pwd -P
}

ROOT=$(project_root)
ROOT=$(cd "$ROOT" && pwd -P)
ROOT_HASH=$(printf '%s' "$ROOT" | cksum | awk '{print $1}')
STATE_DIR=${PI_TMUX_STATE_DIR:-"$ROOT/.pi/tmux-subagents"}
SESSION=${PI_TMUX_SESSION:-"pi-agents-$ROOT_HASH"}
AGENTS_DIR="$STATE_DIR/agents"
WORKTREES_DIR=${PI_TMUX_WORKTREES_DIR:-"$HOME/.pi/agent/tmux-worktrees/$ROOT_HASH"}

safe_name() {
  local raw=$1 safe
  safe=$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9_-]+/-/g; s/^[-_]+//; s/[-_]+$//')
  [[ -n "$safe" ]] || die "agent name becomes empty after sanitisation"
  [[ ${#safe} -le 63 ]] || die "agent name is too long after sanitisation (max 63 characters)"
  [[ "$safe" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || die "invalid agent name: $raw"
  printf '%s' "$safe"
}

agent_dir() { printf '%s/%s' "$AGENTS_DIR" "$(safe_name "$1")"; }
assert_agent_dir() {
  local dir=$1
  [[ "$(dirname "$dir")" == "$AGENTS_DIR" && "$(basename "$dir")" != . && "$(basename "$dir")" != .. ]] ||
    die "refusing unsafe agent path: $dir"
}
read_file() { [[ -f "$1" ]] && cat "$1" || true; }
write_atomic() { local path=$1 value=$2; printf '%s\n' "$value" >"$path.tmp"; mv "$path.tmp" "$path"; }

ensure_dirs() {
  mkdir -p "$AGENTS_DIR" "$WORKTREES_DIR"
  cat >"$STATE_DIR/swarm.env" <<EOF_ENV
ROOT=$ROOT
SESSION=$SESSION
STATE_DIR=$STATE_DIR
EOF_ENV
}

tmux_alive() {
  local target=$1
  tmux display-message -p -t "$target" '#{window_id}' >/dev/null 2>&1
}

get_target() {
  local dir=$1 target
  target=$(read_file "$dir/tmux-target")
  [[ -n "$target" ]] || die "missing tmux target for $(basename "$dir")"
  printf '%s' "$target"
}

status_value() {
  local dir=$1 status target
  status=$(read_file "$dir/status")
  [[ -n "$status" ]] || status=unknown
  if [[ "$status" == starting || "$status" == running ]]; then
    target=$(read_file "$dir/tmux-target")
    if [[ -n "$target" ]] && ! tmux_alive "$target"; then
      status=exited
    fi
  fi
  printf '%s' "$status"
}

cmd_doctor() {
  local failed=0
  for c in bash tmux pi; do
    if has "$c"; then
      printf 'ok   %-8s %s\n' "$c" "$(command -v "$c")"
    else
      printf 'MISS %-8s not found\n' "$c"
      failed=1
    fi
  done
  if has git && git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    printf 'ok   %-8s %s\n' git "$(git -C "$ROOT" rev-parse --show-toplevel)"
  elif has git; then
    printf 'warn %-8s current directory is not a Git worktree; --worktree unavailable\n' git
  else
    printf 'warn %-8s not found; --worktree unavailable\n' git
  fi
  printf 'info session  %s\n' "$SESSION"
  printf 'info state    %s\n' "$STATE_DIR"
  return "$failed"
}

cmd_init() {
  ensure_dirs
  printf 'initialised %s\n' "$STATE_DIR"
  printf 'tmux session %s (created on first start)\n' "$SESSION"
}

build_prompt() {
  local name=$1 dir=$2 cwd=$3 task=$4 branch=$5
  local status_file="$dir/status" result_file="$dir/result.md" failure_file="$dir/failure.md"
  local q_status q_result q_failure
  printf -v q_status '%q' "$status_file"
  printf -v q_result '%q' "$result_file"
  printf -v q_failure '%q' "$failure_file"

  cat >"$dir/prompt.md" <<EOF_HEAD
# Managed Pi subagent: $name

You are a child Pi coding-agent session managed by a parent Pi through tmux.

## Assignment

$task

## Working environment

- Working directory: $cwd
- Branch: ${branch:-shared/no dedicated branch}
- Agent state directory: $dir
- Status file: $status_file
- Result file: $result_file
- Failure file: $failure_file
EOF_HEAD

  cat >>"$dir/prompt.md" <<'EOF_BODY'

## Mandatory operating contract

1. Work only on this assignment. Normal project work must stay inside the assigned working directory. Writing the manager-provided status, result, and failure files is explicitly allowed.
2. Do not spawn more agents unless the assignment explicitly tells you to orchestrate.
3. Keep changes minimal and scoped. Do not merge, rebase, push, or modify the manager's branch.
4. Treat later user messages in this session as steering from the manager or human.
5. While actively working, ensure the status file contains exactly `running`.
6. If blocked, write a useful explanation and the precise decision needed to the result file, then atomically set status to `blocked`. Remain in this Pi session for steering.
7. On success, completely write the result file using the format below, then atomically set status to `done`. Do not set `done` before the result file is complete.
8. On failure, write the failure file and any useful partial handoff, then atomically set status to `failed`.
9. After reporting a terminal status, remain available in the Pi session. Do not run `/quit` unless instructed.

Use shell commands equivalent to the following for atomic status updates; substitute `running`, `blocked`, `done`, or `failed` as appropriate:
EOF_BODY

  printf '\n    printf '\''%%s\\n'\'' done > %s.tmp && mv %s.tmp %s\n' "$q_status" "$q_status" "$q_status" >>"$dir/prompt.md"

  cat >>"$dir/prompt.md" <<EOF_PATHS

Write the complete result to $q_result. Write failure details to $q_failure.
EOF_PATHS

  cat >>"$dir/prompt.md" <<'EOF_RESULT'

## Required result format

```markdown
# Result

## Outcome
What you accomplished or concluded.

## Evidence
Files, line ranges, commands, and important observations.

## Changes
Files changed and why, or "None".

## Validation
Tests/checks run and their outcomes; identify anything not validated.

## Risks and open questions
Remaining uncertainty, edge cases, or conflicts.

## Handoff
The exact next step the manager should take.
```

Begin now. First set status to `running`, then perform the assignment.
EOF_RESULT
}

shell_join() {
  local out='' q arg
  for arg in "$@"; do
    printf -v q '%q' "$arg"
    out+="$q "
  done
  printf '%s' "$out"
}

cmd_start() {
  [[ $# -ge 1 ]] || die "start requires NAME"
  local original_name=$1 name dir task='' task_file='' cwd="$ROOT" use_worktree=0 cwd_set=0
  local model='' provider='' thinking='' tools='' no_context=0 approve_project=0 inherit_resources=0 branch=''
  local created_worktree=0 target=''
  shift
  name=$(safe_name "$original_name")
  dir=$(agent_dir "$name")
  [[ ! -e "$dir" ]] || die "agent '$name' already exists; clean it or choose another name"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --worktree) use_worktree=1; shift ;;
      --cwd) [[ $# -ge 2 ]] || die "--cwd requires DIR"; cwd=$2; cwd_set=1; shift 2 ;;
      --model) [[ $# -ge 2 ]] || die "--model requires MODEL"; model=$2; shift 2 ;;
      --provider) [[ $# -ge 2 ]] || die "--provider requires PROVIDER"; provider=$2; shift 2 ;;
      --thinking) [[ $# -ge 2 ]] || die "--thinking requires LEVEL"; thinking=$2; shift 2 ;;
      --tools) [[ $# -ge 2 ]] || die "--tools requires LIST"; tools=$2; shift 2 ;;
      --no-context) no_context=1; shift ;;
      --approve-project) approve_project=1; shift ;;
      --inherit-resources) inherit_resources=1; shift ;;
      --task-file) [[ $# -ge 2 ]] || die "--task-file requires FILE"; task_file=$2; shift 2 ;;
      --) shift; task="$*"; break ;;
      *) die "unknown start option: $1" ;;
    esac
  done

  [[ $use_worktree -eq 0 || $cwd_set -eq 0 ]] || die "use either --worktree or --cwd, not both"
  if [[ -n "$task_file" ]]; then
    [[ -f "$task_file" ]] || die "task file not found: $task_file"
    [[ -z "$task" ]] || die "provide task via --task-file or after --, not both"
    task=$(cat "$task_file")
  fi
  [[ -n "${task//[[:space:]]/}" ]] || die "task is empty"
  if [[ $use_worktree -eq 1 ]]; then
    has git || die "git is required for --worktree"
    git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "--worktree requires a Git repository"
    cwd="$WORKTREES_DIR/$name"
    [[ ! -e "$cwd" ]] || die "worktree path already exists: $cwd"
    branch="pi-agent/$name-$(date -u +%Y%m%d%H%M%S)"
  else
    [[ -d "$cwd" ]] || die "working directory not found: $cwd"
    cwd=$(cd "$cwd" && pwd -P)
  fi

  start_rollback() {
    local rc=$?
    trap - ERR
    if [[ -n "$target" ]] && tmux_alive "$target"; then
      tmux kill-window -t "$target" 2>/dev/null || true
    fi
    if [[ $created_worktree -eq 1 ]]; then
      git -C "$ROOT" worktree remove --force "$cwd" >/dev/null 2>&1 || true
      git -C "$ROOT" branch -D "$branch" >/dev/null 2>&1 || true
    fi
    if [[ -n "$dir" ]]; then
      assert_agent_dir "$dir"
      rm -rf "$dir"
    fi
    return "$rc"
  }
  trap start_rollback ERR

  ensure_dirs
  mkdir -p "$dir/session"
  printf '%s\n' "$task" >"$dir/task.md"
  printf '%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$dir/started-at"
  write_atomic "$dir/status" starting

  if [[ $use_worktree -eq 1 ]]; then
    git -C "$ROOT" worktree add -b "$branch" "$cwd" HEAD >/dev/null
    created_worktree=1
  fi

  printf '%s\n' "$cwd" >"$dir/cwd"
  printf '%s\n' "$branch" >"$dir/branch"
  build_prompt "$name" "$dir" "$cwd" "$task" "$branch"

  local -a pi_args
  pi_args=(pi --name "subagent:$name" --session-dir "$dir/session")
  if [[ $approve_project -eq 1 ]]; then
    pi_args+=(--approve)
  else
    pi_args+=(--no-approve)
  fi
  if [[ $inherit_resources -eq 0 ]]; then
    pi_args+=(--no-extensions --no-skills)
  fi
  [[ -n "$model" ]] && pi_args+=(--model "$model")
  [[ -n "$provider" ]] && pi_args+=(--provider "$provider")
  [[ -n "$thinking" ]] && pi_args+=(--thinking "$thinking")
  [[ -n "$tools" ]] && pi_args+=(--tools "$tools")
  [[ $no_context -eq 1 ]] && pi_args+=(--no-context-files)
  pi_args+=("@$dir/prompt.md" "Execute the managed assignment in the attached brief.")

  local shell_cmd window="agent-$name"
  shell_cmd=$(shell_join "$RUNNER" "$dir" "${pi_args[@]}")
  if tmux has-session -t "$SESSION" 2>/dev/null; then
    target=$(tmux new-window -d -P -F '#{window_id}' -t "$SESSION:" -n "$window" -c "$cwd" "bash -c $(printf '%q' "$shell_cmd")")
  else
    target=$(tmux new-session -d -P -F '#{window_id}' -s "$SESSION" -n "$window" -c "$cwd" "bash -c $(printf '%q' "$shell_cmd")")
  fi
  printf '%s\n' "$target" >"$dir/tmux-target"
  write_atomic "$dir/status" running
  trap - ERR

  printf 'started %-20s %s\n' "$name" "$target"
  printf 'cwd     %s\n' "$cwd"
  if [[ -n "$branch" ]]; then
    printf 'branch  %s\n' "$branch"
  fi
}

require_agent() {
  local dir
  dir=$(agent_dir "$1")
  assert_agent_dir "$dir"
  [[ -d "$dir" ]] || die "unknown agent: $(safe_name "$1")"
  printf '%s' "$dir"
}

cmd_send() {
  [[ $# -ge 2 ]] || die "send requires NAME and MESSAGE"
  local name=$1 dir target message buffer
  shift
  message="$*"
  dir=$(require_agent "$name")
  target=$(get_target "$dir")
  tmux_alive "$target" || die "tmux target is not alive: $target"
  buffer="pi-agent-$(safe_name "$name")-$RANDOM"
  printf '%s' "$message" | tmux load-buffer -b "$buffer" -
  tmux paste-buffer -b "$buffer" -d -t "$target"
  tmux send-keys -t "$target" Enter
  printf 'sent to %s\n' "$(safe_name "$name")"
}

print_status_one() {
  local name=$1 dir status cwd target branch
  dir=$(require_agent "$name")
  status=$(status_value "$dir")
  cwd=$(read_file "$dir/cwd")
  target=$(read_file "$dir/tmux-target")
  branch=$(read_file "$dir/branch")
  printf '%-22s %-9s %-28s %s\n' "$(safe_name "$name")" "$status" "${target:--}" "${branch:-$cwd}"
}

cmd_status() {
  if [[ $# -gt 0 ]]; then
    printf '%-22s %-9s %-28s %s\n' NAME STATUS TMUX BRANCH_OR_CWD
    print_status_one "$1"
    return
  fi
  ensure_dirs
  printf '%-22s %-9s %-28s %s\n' NAME STATUS TMUX BRANCH_OR_CWD
  local found=0 dir
  shopt -s nullglob
  for dir in "$AGENTS_DIR"/*; do
    found=1
    print_status_one "$(basename "$dir")"
  done
  shopt -u nullglob
  [[ $found -eq 1 ]] || printf '(no agents)\n'
}

cmd_capture() {
  [[ $# -ge 1 ]] || die "capture requires NAME"
  local dir target lines=${2:-80}
  [[ "$lines" =~ ^[0-9]+$ ]] || die "LINES must be a non-negative integer"
  dir=$(require_agent "$1")
  target=$(get_target "$dir")
  tmux_alive "$target" || die "tmux target is not alive: $target"
  tmux capture-pane -p -J -S "-$lines" -t "$target"
}

cmd_result() {
  [[ $# -ge 1 ]] || die "result requires NAME"
  local dir status
  dir=$(require_agent "$1")
  status=$(status_value "$dir")
  printf 'status: %s\n\n' "$status"
  if [[ -s "$dir/result.md" ]]; then
    cat "$dir/result.md"
  elif [[ -s "$dir/failure.md" ]]; then
    cat "$dir/failure.md"
  else
    printf '(no result yet)\n'
  fi
}

cmd_info() {
  [[ $# -ge 1 ]] || die "info requires NAME"
  local dir field=''
  dir=$(require_agent "$1")
  shift
  if [[ $# -gt 0 ]]; then
    [[ "$1" == --field && $# -ge 2 ]] || die "usage: info NAME [--field FIELD]"
    field=$2
  fi
  if [[ -n "$field" ]]; then
    case "$field" in
      name) basename "$dir" ;;
      status) status_value "$dir"; printf '\n' ;;
      cwd|branch|tmux-target|started-at) read_file "$dir/$field"; printf '\n' ;;
      state-dir) printf '%s\n' "$dir" ;;
      *) die "unknown field: $field" ;;
    esac
    return
  fi
  printf 'name:       %s\n' "$(basename "$dir")"
  printf 'status:     %s\n' "$(status_value "$dir")"
  printf 'cwd:        %s\n' "$(read_file "$dir/cwd")"
  printf 'branch:     %s\n' "$(read_file "$dir/branch")"
  printf 'tmux:       %s\n' "$(read_file "$dir/tmux-target")"
  printf 'started-at: %s\n' "$(read_file "$dir/started-at")"
  printf 'state-dir:  %s\n' "$dir"
}

wait_one() {
  local name=$1 timeout=$2 started now status
  started=$(date +%s)
  while :; do
    status=$(status_value "$(require_agent "$name")")
    case "$status" in
      done) printf '%s done\n' "$(safe_name "$name")"; return 0 ;;
      blocked) printf '%s blocked\n' "$(safe_name "$name")"; return 2 ;;
      failed|exited|stopped) printf '%s %s\n' "$(safe_name "$name")" "$status"; return 1 ;;
    esac
    now=$(date +%s)
    if (( timeout > 0 && now - started >= timeout )); then
      printf '%s timeout\n' "$(safe_name "$name")"
      return 124
    fi
    sleep 2
  done
}

cmd_wait() {
  [[ $# -ge 1 ]] || die "wait requires NAME"
  local timeout=${2:-0}
  [[ "$timeout" =~ ^[0-9]+$ ]] || die "timeout must be a non-negative integer"
  wait_one "$1" "$timeout"
}

cmd_wait_all() {
  local timeout=${1:-0} started now pending status dir name failed=0 blocked=0
  [[ "$timeout" =~ ^[0-9]+$ ]] || die "timeout must be a non-negative integer"
  started=$(date +%s)
  while :; do
    pending=0
    failed=0
    blocked=0
    shopt -s nullglob
    local dirs=("$AGENTS_DIR"/*)
    shopt -u nullglob
    [[ ${#dirs[@]} -gt 0 ]] || { printf '(no agents)\n'; return 0; }
    for dir in "${dirs[@]}"; do
      name=$(basename "$dir")
      status=$(status_value "$dir")
      case "$status" in
        starting|running|unknown) pending=1 ;;
        blocked) blocked=1 ;;
        failed|exited|stopped) failed=1 ;;
      esac
    done
    if [[ $pending -eq 0 ]]; then
      cmd_status
      [[ $failed -eq 0 ]] || return 1
      [[ $blocked -eq 0 ]] || return 2
      return 0
    fi
    now=$(date +%s)
    if (( timeout > 0 && now - started >= timeout )); then
      cmd_status
      return 124
    fi
    sleep 2
  done
}

cmd_stop() {
  [[ $# -ge 1 ]] || die "stop requires NAME"
  local dir target status
  dir=$(require_agent "$1")
  target=$(read_file "$dir/tmux-target")
  if [[ -n "$target" ]] && tmux_alive "$target"; then
    tmux kill-window -t "$target"
  fi
  status=$(status_value "$dir")
  case "$status" in done|failed|blocked) ;; *) write_atomic "$dir/status" stopped ;; esac
  printf 'stopped %s\n' "$(safe_name "$1")"
}

cmd_stop_all() {
  ensure_dirs
  local dir name
  shopt -s nullglob
  for dir in "$AGENTS_DIR"/*; do
    name=$(basename "$dir")
    cmd_stop "$name"
  done
  shopt -u nullglob
  if tmux has-session -t "$SESSION" 2>/dev/null; then
    tmux kill-session -t "$SESSION" 2>/dev/null || true
  fi
}

cmd_clean() {
  [[ $# -ge 1 ]] || die "clean requires NAME"
  local name=$1 remove_worktree=0 dir target cwd branch
  shift
  if [[ $# -gt 0 ]]; then
    [[ "$1" == --remove-worktree ]] || die "unknown clean option: $1"
    remove_worktree=1
  fi
  dir=$(require_agent "$name")
  assert_agent_dir "$dir"
  target=$(read_file "$dir/tmux-target")
  if [[ -n "$target" ]] && tmux_alive "$target"; then
    die "agent is still running; stop it first"
  fi
  cwd=$(read_file "$dir/cwd")
  branch=$(read_file "$dir/branch")
  if [[ $remove_worktree -eq 1 && -n "$branch" && -n "$cwd" ]]; then
    git -C "$ROOT" worktree remove "$cwd"
  fi
  rm -rf "$dir"
  printf 'cleaned %s\n' "$(safe_name "$name")"
  if [[ $remove_worktree -eq 1 && -n "$branch" ]]; then
    printf 'retained branch %s (delete manually when appropriate)\n' "$branch"
  fi
}

cmd_clean_all() {
  ensure_dirs
  local dir status
  shopt -s nullglob
  for dir in "$AGENTS_DIR"/*; do
    status=$(status_value "$dir")
    case "$status" in
      running|starting) err "skipping active agent $(basename "$dir")" ;;
      *) rm -rf "$dir" ;;
    esac
  done
  shopt -u nullglob
  printf 'cleaned non-active agent state; worktrees retained\n'
}

main() {
  local cmd=${1:-}
  [[ -n "$cmd" ]] || { usage; exit 64; }
  shift || true
  case "$cmd" in
    doctor) cmd_doctor "$@" ;;
    init) cmd_init "$@" ;;
    start) cmd_start "$@" ;;
    send) cmd_send "$@" ;;
    status|list) cmd_status "$@" ;;
    capture) cmd_capture "$@" ;;
    result) cmd_result "$@" ;;
    info) cmd_info "$@" ;;
    wait) cmd_wait "$@" ;;
    wait-all) cmd_wait_all "$@" ;;
    stop) cmd_stop "$@" ;;
    stop-all) cmd_stop_all "$@" ;;
    clean) cmd_clean "$@" ;;
    clean-all) cmd_clean_all "$@" ;;
    -h|--help|help) usage ;;
    *) usage >&2; die "unknown command: $cmd" ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
